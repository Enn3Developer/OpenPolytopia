<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNext.Threading" Version="6.6.5"/>
    <PackageReference Include="GodotSharp" Version="4.7.2"/>
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <!-- the game data lives in the godot project so it can be edited from the editor, see OpenPolytopia/src/Data -->
  <ItemGroup>
    <EmbeddedResource Include="..\OpenPolytopia\resources\troops.json" LogicalName="OpenPolytopia.Common.resources.troops.json"/>
    <EmbeddedResource Include="..\OpenPolytopia\resources\tribes.json" LogicalName="OpenPolytopia.Common.resources.tribes.json"/>
    <EmbeddedResource Include="..\OpenPolytopia\resources\tech_tree.json" LogicalName="OpenPolytopia.Common.resources.tech_tree.json"/>
    <EmbeddedResource Include="..\OpenPolytopia\resources\buildings.json" LogicalName="OpenPolytopia.Common.resources.buildings.json"/>
  </ItemGroup>

</Project>
